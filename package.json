{
  "name": "ai-assist",
  "version": "1.1.0",
  "type": "module",
  "description": "Obsidian plugin: sidebar AI chat and in-place rewriting of the selected text.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node tools/test-parse.mjs",
    "build:deploy": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production --deploy",
    "test:subscription": "node tools/test-chatgpt.mjs",
    "test:auth": "node tools/test-chatgpt-auth.mjs",
    "test:all": "npm test && npm run test:subscription && npm run test:auth && npm run test:quota && npm run test:composer",
    "test:quota": "node tools/test-chatgpt-quota.mjs && node tools/test-chatgpt-quota-view.mjs",
    "test:composer": "node tools/test-chat-composer.mjs",
    "test:composer-layout": "node tools/test-chat-composer.mjs --layout"
  },
  "keywords": [
    "obsidian-plugin",
    "ai",
    "llm",
    "deepseek"
  ],
  "author": "mrrepac",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "moment": "^2.30.1",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "allowScripts": {
    "esbuild@0.17.3": true
  }
}
